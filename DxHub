local function openHub() local zoomOut=TweenService:Create(icon,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.new(0,0,0,0)}) zoomOut:Play() zoomOut.Completed:Wait() icon.Visible=false hub.Visible=true hub.Size=UDim2.new(0,100,0,100) hub.BackgroundTransparency=1 local tween=TweenService:Create(hub,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(0,460,0,340),BackgroundTransparency=0}) tween:Play() end
