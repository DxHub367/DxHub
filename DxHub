-- 🌀 Hiệu ứng mở / đóng
local function openHub()
	local zoomOut = TweenService:Create(icon, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
	zoomOut:Play()
	zoomOut.Completed:Wait()
	icon.Visible = false

	hub.Visible = true
	hub.Size = UDim2.new(0, 100, 0, 100)
	hub.BackgroundTransparency = 1

	local tween = TweenService:Create(hub, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 460, 0, 340),
		BackgroundTransparency = 0
	})
	tween:Play()
end

local function closeHub()
	local tween = TweenService:Create(hub, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 100, 0, 100),
		BackgroundTransparency = 1
	})
	tween:Play()
	tween.Completed:Wait()
	hub.Visible = false

	icon.Visible = true
	icon.Size = UDim2.new(0, 0, 0, 0)
	local zoomIn = TweenService:Create(icon, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 50, 0, 50)})
	zoomIn:Play()
end

icon.MouseButton1Click:Connect(openHub)
closeBtn.MouseButton1Click:Connect(closeHub)

