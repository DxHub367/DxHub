local tabState={} 
local function showNotif(titleText,bodyText,duration) duration=duration or 6 notifTitle.Text=titleText or "Thông báo" notifBody.Text=bodyText or "" notifFrame.Visible=true local t=TweenService:Create(notifFrame,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{BackgroundTransparency=0}) t:Play() delay(duration,function() if notifFrame and notifFrame.Visible then local t2=TweenService:Create(notifFrame,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{BackgroundTransparency=1}) t2:Play() t2.Completed:Wait() notifFrame.Visible=false end end) end
local function CreateButton(text,url,notifTitle,notifBody) local btn=Instance.new("TextButton") btn.Size=UDim2.new(1,-20,0,50) btn.BackgroundColor3=Color3.fromRGB(45,45,45) btn.TextColor3=Color3.fromRGB(255,255,255) btn.Font=Enum.Font.GothamBold btn.TextSize=22 btn.Text=text btn.Parent=scroll Instance.new("UICorner",btn).CornerRadius=UDim.new(0,10) tabState[btn]={clicked=false,timer=nil} btn.MouseButton1Click:Connect(function() local state=tabState[btn] if not state.clicked then state.clicked=true showNotif(notifTitle or text,notifBody or ("Bạn đã chọn tab: "..text)) if state.timer then pcall(function() state.timer:Cancel() end) state.timer=nil end state.timer=delay(6,function() if tabState[btn] then tabState[btn].clicked=false tabState[btn].timer=nil end end) return end state.clicked=false if state.timer then state.timer=nil end local orig=btn.BackgroundColor3 local t=TweenService:Create(btn,TweenInfo.new(0.12,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundColor3=Color3.fromRGB(70,70,70)}) t:Play() delay(0.12,function() if btn and btn.Parent then local t2=TweenService:Create(btn,TweenInfo.new(0.12,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundColor3=orig}) t2:Play() end end) local ok,err=pcall(function() if url and #url>0 then loadstring(game:HttpGet(url,true))() end end) if not ok then showNotif("Lỗi khi chạy script",tostring(err),4) end end) end
